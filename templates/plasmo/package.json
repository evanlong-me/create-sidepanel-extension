{
  "name": "sidepanel-extension-plasmo-template",
  "displayName": "Sidepanel Template",
  "description": "A modern browser extension template with sidepanel support, built with Plasmo + Tailwind CSS 4.0 + shadcn/ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "compile": "tsc --noEmit"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.15.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "plasmo": "^0.90.5",
    "postcss": "^8.5.25",
    "typescript": "^7.0.2"
  },
  "manifest": {
    "permissions": [
      "sidePanel",
      "storage"
    ],
    "action": {
      "default_title": "Open Sidepanel"
    }
  },
  "packageManager": "pnpm@11.20.0"
}
